---
// src/components/MatterContent.astro
const { title } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<div class="matter-content-wrapper">
    <div class="back-link">
        <a href={base}>← Back to Voting Overview</a>
    </div>
    <article class="voting-document">
        <slot />
    </article>
</div>

<style>
    .back-link { margin-bottom: 20px; }
    .back-link a { color: var(--swiss-red); text-decoration: none; font-weight: bold; }
    .back-link a:hover { text-decoration: underline; }
    .voting-document { font-size: 1.05rem; }
</style>
