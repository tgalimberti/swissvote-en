---
// src/components/BookletHero.astro
const base = import.meta.env.BASE_URL;
---

<div class="booklet-hero">
    <!-- Row 1: The Date -->
    <div class="booklet-row booklet-header">
        <div class="booklet-label">Popular vote</div>
        <div class="booklet-title date-title">14 June 2026</div>
    </div>

    <!-- FEDERAL SECTION -->
    <div class="section-divider">Federal Matters</div>

    <!-- Row 2: First Matter -->
    <a href={`${base}matters/2026-06-14-federal-sustainability`} class="booklet-row matter-link">
        <div class="booklet-label">First matter</div>
        <div class="booklet-title">
            <span class="matter-type">Popular initiative</span><br/>
            «No to a 10 million Switzerland! (Sustainability Initiative)»
        </div>
        <div class="chevron">→</div>
    </a>

    <!-- Row 3: Second Matter -->
    <a href={`${base}matters/2026-06-14-federal-civil-service`} class="booklet-row matter-link">
        <div class="booklet-label">Second matter</div>
        <div class="booklet-title">
            <span class="matter-type">Amendment to the law</span><br/>
            Civil Service Act
        </div>
        <div class="chevron">→</div>
    </a>

    <!-- CANTONAL SECTION (TICINO) -->
    <div class="section-divider cantonal">Cantonal Matters (Ticino)</div>

    <!-- Row 4: First Matter (1st Cantonal) -->
    <a href={`${base}matters/2026-06-14-cantonal-ti-dental-care`} class="booklet-row matter-link">
        <div class="booklet-label">First matter</div>
        <div class="booklet-title">
            <span class="matter-type">Generic legislative popular initiative</span><br/>
            «For the reimbursement of dental care»
        </div>
        <div class="chevron">→</div>
    </a>

    <!-- Row 5: Second Matter (2nd Cantonal) -->
    <a href={`${base}matters/2026-06-14-cantonal-ti-valuations`} class="booklet-row matter-link">
        <div class="booklet-label">Second matter</div>
        <div class="booklet-title">
            <span class="matter-type">Elaborated constitutional popular initiative</span><br/>
            «Yes to the neutralization of the increase in real estate valuations»
        </div>
        <div class="chevron">→</div>
    </a>
</div>

<style>
    /* Light Mode */
    .booklet-hero {
        background-color: var(--swiss-red);
        color: white;
        padding: 30px 40px;
        border-radius: 6px;
        margin-top: 20px;
        margin-bottom: 40px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        display: flex;
        flex-direction: column;
        overflow: hidden; 
    }

    .booklet-row {
        display: grid;
        grid-template-columns: 1fr 3fr 20px;
        gap: 20px;
        padding: 25px 0;
        border-bottom: 1px solid rgba(255, 255, 255, 0.3);
        text-decoration: none; 
        color: inherit;
    }

    .booklet-header { padding-top: 0; }
    .booklet-row:last-child { border-bottom: none; padding-bottom: 0; }

    .booklet-label { font-size: 1rem; font-weight: 600; opacity: 0.9; }
    .booklet-title { font-size: 1.6rem; font-weight: bold; line-height: 1.3; }
    .date-title { font-size: 2.5rem; }
    .matter-type { font-size: 1.2rem; font-weight: normal; opacity: 0.9; }
    
    /* Section Dividers */
    .section-divider {
        background-color: rgba(0, 0, 0, 0.2);
        padding: 10px 40px;
        margin: 0 -40px; 
        font-weight: bold;
        text-transform: uppercase;
        letter-spacing: 1px;
        font-size: 0.9rem;
    }
    .section-divider.cantonal {
        margin-top: 15px;
    }

    /* Interactive Link Styles */
    .chevron {
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        opacity: 0; 
        transition: opacity 0.2s, transform 0.2s;
    }
    
    a.matter-link:hover {
        background-color: rgba(0, 0, 0, 0.05);
        cursor: pointer;
    }
    a.matter-link:hover .chevron {
        opacity: 1;
        transform: translateX(5px);
    }

    /* Dark Mode Overrides */
    html.dark .booklet-hero {
        background-color: var(--card-bg);
        color: var(--text-color);
        border: 1px solid var(--border-color);
        box-shadow: none;
    }
    html.dark .booklet-row { border-bottom: 1px solid var(--border-color); }
    html.dark .booklet-label { color: var(--swiss-red); }
    html.dark a.matter-link:hover { background-color: rgba(255, 255, 255, 0.03); }
    html.dark .section-divider { background-color: rgba(255, 255, 255, 0.05); }

    /* Mobile */
    @media (max-width: 600px) {
        .booklet-hero { padding: 20px; }
        .booklet-row { grid-template-columns: 1fr; gap: 5px; padding: 15px 0; }
        .section-divider { padding: 10px 20px; margin: 0 -20px; }
        .chevron { display: none; }
        .date-title { font-size: 2rem; }
        .booklet-title { font-size: 1.3rem; }
    }
</style>
